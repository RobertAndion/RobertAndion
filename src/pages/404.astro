---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page doesn't exist." noindex>
  <div class="wrap page">
    <p class="eyebrow">cd: no such file or directory</p>
    <h1>404 — page not found</h1>
    <p class="lede">The page you're looking for doesn't exist or has moved.</p>
    <p class="actions"><a class="btn btn-primary" href="/">Back home</a></p>
  </div>
</Base>
